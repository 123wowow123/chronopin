  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-sns": "^3.1131.0",
    "@azure/storage-blob": "^12.33.0",
    "@date-fns/tz": "^1.5.0",
    "@editorjs/editorjs": "^2.31.6",
    "@editorjs/embed": "^2.8.0",
    "@editorjs/header": "^2.8.9",
    "@editorjs/image": "^2.10.3",
    "@editorjs/list": "^1.10.0",
    "@sotaproject/strikethrough": "^1.0.1",
    "date-fns": "^4.4.0",
    "date-holidays": "^3.36.1",
    "editorjs-parser": "^1.5.3",
    "get-video-id": "^4.2.0",
    "jimp": "^1.6.1",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lodash": "^4.18.1",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "puppeteer": "^25.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "js-yaml": "^4.3.2",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "allowScripts": {
    "puppeteer@25.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
