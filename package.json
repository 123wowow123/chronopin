{
  "name": "chronopin",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "create:db": "tsx scripts/db/migrate.ts",
    "db:reset": "tsx scripts/db/migrate.ts --reset",
    "db:refresh": "npm run create:db && npm run create:data",
    "create:data": "tsx scripts/data/index.ts --seed",
    "backup:data": "tsx scripts/data/index.ts --save",
    "clean:e2e": "tsx scripts/data/cleanE2e.ts",
    "search:refresh": "npm run delete:search:pins && npm run create:search",
    "create:search": "tsx scripts/search/index.ts --seed",
    "delete:search:pins": "tsx scripts/search/index.ts --reset",
    "init:shebang": "npm run db:refresh && npm run search:refresh",
    "companies:logos": "tsx scripts/company/logos.ts",
    "companies:describe": "tsx scripts/company/descriptions.ts",
    "media:video-thumbs": "tsx scripts/media/videoThumbs.ts",
    "media:screen": "tsx scripts/media/screenDetails.ts",
    "launches:upcoming": "tsx scripts/launches/upcoming.ts",
    "tv:premieres": "tsx scripts/tv/premieres.ts",
    "health:trials": "tsx scripts/health/trials.ts",
    "spacex:launches": "tsx scripts/launches/upcoming.ts --provider SpaceX",
    "media:awards": "tsx scripts/media/awards.ts",
    "media:studio-locations": "tsx scripts/media/studioLocations.ts",
    "media:top-up": "tsx scripts/media/topUp.ts",
    "media:dedupe": "tsx scripts/media/dedupe.ts",
    "media:score-markets": "tsx scripts/media/scoreMarkets.ts",
    "markets:volume": "tsx scripts/markets/volume.ts",
    "merchants:amazon-prices": "tsx scripts/merchants/amazonPrices.ts",
    "ai:retirements": "tsx scripts/ai/retirements.ts",
    "sports:tournaments": "tsx scripts/sports/tournaments.ts",
    "astronomy:eclipses": "tsx scripts/astronomy/eclipses.ts",
    "trends:discover": "tsx scripts/trends/discover.ts",
    "tags:sync": "tsx scripts/tags/sync.ts",
    "translations:sync": "tsx scripts/translations/sync.ts",
    "threads:prequels": "tsx scripts/threads/prequels.ts",
    "references:list": "tsx scripts/references/list.ts",
    "references:apply": "tsx scripts/references/apply.ts",
    "references:reasoning:list": "tsx scripts/references/reasoningList.ts",
    "references:reasoning:apply": "tsx scripts/references/reasoningApply.ts",
    "references:podcasts": "tsx scripts/references/podcasts.ts",
    "duplicates:suggest": "tsx scripts/duplicates/suggest.ts",
    "duplicates:verify": "tsx scripts/duplicates/verify.ts",
    "comments:sentiment": "tsx scripts/comments/sentiment.ts",
    "wiki:sync": "tsx scripts/wiki/sync.ts",
    "wiki:transcripts": "tsx scripts/wiki/transcripts.ts",
    "wiki:refetch-blocked": "tsx scripts/wiki/refetchBlocked.ts",
    "okf:export": "tsx scripts/okf/export.ts",
    "okf:lint": "tsx scripts/okf/lint.ts",
    "user-wiki:build": "tsx scripts/okf/userWiki.ts",
    "stocks:sync": "tsx scripts/stocks/sync.ts",
    "wiki:export": "tsx scripts/wiki/export.ts",
    "wiki:apply": "tsx scripts/wiki/apply.ts",
    "specialty-days:build": "node scripts/specialtyDays/build.cjs",
    "favicon:build": "tsx scripts/favicon/build.ts"
