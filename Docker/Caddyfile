# HTTPS for chronopin.com. Caddy gets and renews the certificates by itself
# once the domain's A records point at this VM. The site's own URL is www
# (NEXT_PUBLIC_SITE_URL), so the bare domain redirects there. Until the DNS
# points here the certificate requests fail and back off; restart Caddy after
# switching the records to retry at once.

# Deploys (scripts/deploy-image.sh) never leave the site without an upstream:
# `app` is preferred, and `app-next` (the standby, only running during a
# deploy) takes over while `app` is recreated. A request that finds neither
# waits up to 15s for one rather than failing. Passive checks only: a probe of
# a page would mark a busy but healthy app down.
(upstreams) {
	reverse_proxy app:9000 app-next:9000 {
		lb_policy first
		lb_try_duration 15s
		lb_try_interval 250ms
		fail_duration 3s
		max_fails 1
	}
}

# One JSON line per request (client IP, user agent, path, status) on the
# container's stdout, for telling bots from people: docker logs docker-caddy-1.
# Cookies and auth headers are dropped. Added 2026-10-17.
(accesslog) {
	log {
		output stdout
		format filter {
			wrap json
			request>headers>Cookie delete
			request>headers>Authorization delete
		}
	}
}

# The build's hashed /_next/static files, copied into the next-static volume at
# deploy (scripts/deploy-image.sh), are served by Caddy itself: about 40% of all
# requests, and each waited behind the Node event loop (5.9s on average at peak,
# 2026-10-20). A file not there (a volume not yet filled) goes to the app.
www.chronopin.com {
	encode zstd gzip
	import accesslog
	@static {
		path /_next/static/*
		file {
			root /srv/assets
			try_files {path}
		}
	}
	# Every page load asks who is signed in (src/lib/client/session.ts) and the
	# app answers null when the request carries no token cookie, no bearer header
	# and no access_token: the same answer, without waking Node (1,044 of 18,256
	# requests in 5 minutes, 2026-10-20).
	@anonMe {
		method GET
		path /api/users/me
		not header_regexp Cookie (^|;\s*)token=
		not header Authorization *
		not query access_token=*
	}
	handle @anonMe {
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-store"
		respond "null" 200
	}
	handle @static {
		root * /srv/assets
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		import upstreams
	}
}

chronopin.com {
	redir https://www.chronopin.com{uri} permanent
}

# Before the DNS switch, and for anything asked for by IP: plain HTTP to the app.
:80 {
	import upstreams
}
